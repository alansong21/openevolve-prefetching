#!/usr/bin/env bash
set -euo pipefail

# === Config ===
MINIFORGE_DIR="$HOME/miniforge3"
MINIFORGE_INSTALLER="$HOME/miniforge.sh"
ENV_NAME="oe311"
PROJECT_DIR="$HOME/alphaEvolveProject"
PY_VER="3.11"

log() { printf "\n\033[1;32m[setup]\033[0m %s\n" "$*"; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1"; exit 1; }
}

download_miniforge() {
  local arch
  arch=$(uname -m)
  case "$arch" in
    x86_64)   MF="Miniforge3-Linux-x86_64.sh" ;;
    aarch64|arm64) MF="Miniforge3-Linux-aarch64.sh" ;;
    ppc64le)  MF="Miniforge3-Linux-ppc64le.sh" ;;
    s390x)    MF="Miniforge3-Linux-s390x.sh" ;;
    *) echo "Unsupported arch: $arch"; exit 1 ;;
  esac
  local url="https://github.com/conda-forge/miniforge/releases/latest/download/$MF"
  log "Downloading Miniforge for $arch ..."
  if command -v wget >/dev/null 2>&1; then
    wget -q "$url" -O "$MINIFORGE_INSTALLER"
  elif command -v curl >/dev/null 2>&1; then
    curl -sSL "$url" -o "$MINIFORGE_INSTALLER"
  else
    echo "Need either wget or curl to download Miniforge."
    exit 1
  fi
}

install_or_update_miniforge() {
  if [[ -x "$MINIFORGE_DIR/bin/conda" ]]; then
    log "Miniforge detected; updating in place ..."
    bash "$MINIFORGE_INSTALLER" -b -u -p "$MINIFORGE_DIR"
  else
    if [[ -d "$MINIFORGE_DIR" ]]; then
      log "Removing previous incomplete Miniforge at $MINIFORGE_DIR ..."
      rm -rf "$MINIFORGE_DIR"
    fi
    log "Installing Miniforge to $MINIFORGE_DIR ..."
    bash "$MINIFORGE_INSTALLER" -b -p "$MINIFORGE_DIR"
  fi
}

activate_conda() {
  eval "$("$MINIFORGE_DIR/bin/conda" shell.bash hook)"
  conda config --set always_yes yes --set changeps1 no >/dev/null
  conda --version
}

ensure_env() {
  if conda env list | awk '{print $1}' | grep -qx "$ENV_NAME"; then
    log "Conda env '$ENV_NAME' already exists."
  else
    log "Creating conda env '$ENV_NAME' with Python $PY_VER and pip ..."
    conda create -n "$ENV_NAME" "python=$PY_VER" pip
  fi
  conda activate "$ENV_NAME"
}

install_openevolve() {
  log "Upgrading pip and installing openevolve ..."
  python -m pip install --upgrade pip
  pip install --no-cache-dir openevolve
}

update_submodules() {
  log "Initializing and updating git submodules recursively ..."
  git submodule update --init --recursive
}

point_openevolve_to_fork() {
  local sub_dir="openevolve"
  if [[ -d "$sub_dir/.git" ]]; then
    log "Pointing openevolve submodule to fork: https://github.com/alansong21/openevolve.git"
    git -C "$sub_dir" remote set-url origin https://github.com/alansong21/openevolve.git
    git -C "$sub_dir" fetch origin
  else
    log "openevolve submodule not found; skipping remote update."
  fi
}

build_champsim_deps() {
  local champsim_dir="$PROJECT_DIR/ChampSim"
  if [[ -d "$champsim_dir" ]]; then
    log "Found ChampSim at $champsim_dir — bootstrapping vcpkg and installing deps ..."
    cd "$champsim_dir"
    if [[ -x "vcpkg/bootstrap-vcpkg.sh" ]]; then
      ./vcpkg/bootstrap-vcpkg.sh
    else
      log "bootstrap-vcpkg.sh not found — cloning vcpkg ..."
      git clone https://github.com/microsoft/vcpkg.git
      ./vcpkg/bootstrap-vcpkg.sh
    fi
    ./vcpkg/vcpkg install
    cd "$PROJECT_DIR"
  else
    log "No ChampSim directory found — skipping dependency build."
  fi
}

make_project_dir() {
  log "Ensuring project directory exists at $PROJECT_DIR ..."
  mkdir -p "$PROJECT_DIR"
}

main() {
  need_cmd uname
  need_cmd git
  download_miniforge
  install_or_update_miniforge
  activate_conda
  ensure_env
  install_openevolve
  make_project_dir
  update_submodules
  point_openevolve_to_fork
  build_champsim_deps

  log "✅ Setup complete!"
  echo
  echo "Next steps:"
  echo "1. Activate your environment:"
  echo "   source \"$MINIFORGE_DIR/bin/activate\" \"$ENV_NAME\""
  echo
  echo "2. Run OpenEvolve (example):"
  echo "   python3 openevolve/openevolve-run.py \\"
  echo "     examples/function_minimization/initial_program.py \\"
  echo "     examples/function_minimization/evaluator.py \\"
  echo "     --config examples/function_minimization/config.yaml"
  echo
  echo "3. Project directory:"
  echo "   $PROJECT_DIR"
  echo
}

main "$@"
