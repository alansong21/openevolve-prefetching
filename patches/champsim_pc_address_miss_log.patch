diff --git a/src/cache_stats.cc b/src/cache_stats.cc
index 0c47493..650199b 100644
--- a/src/cache_stats.cc
+++ b/src/cache_stats.cc
@@ -1,5 +1,37 @@
 #include "cache_stats.h"
 
+#include <fstream>
+#include <string>
+
+namespace
+{
+std::string pc_address_miss_log_path;
+} // namespace
+
+bool pc_address_miss_logging_enabled() { return !pc_address_miss_log_path.empty(); }
+
+void configure_pc_address_miss_log(const std::string& output_path) { pc_address_miss_log_path = output_path; }
+
+void write_pc_address_miss_log(const std::vector<cache_stats>& stats)
+{
+  if (pc_address_miss_log_path.empty()) {
+    return;
+  }
+
+  std::ofstream log_file{pc_address_miss_log_path};
+  log_file << "cache cpu pc address misses\n";
+
+  for (const auto& cache_stat : stats) {
+    if (cache_stat.name.find("L2C") == std::string::npos) {
+      continue;
+    }
+    for (const auto& key : cache_stat.pc_address_misses.get_keys()) {
+      log_file << cache_stat.name << ' ' << key.cpu << ' ' << std::hex << "0x" << key.pc << ' ' << "0x" << key.address << std::dec << ' '
+               << cache_stat.pc_address_misses.at(key) << '\n';
+    }
+  }
+}
+
 cache_stats operator-(cache_stats lhs, cache_stats rhs)
 {
   cache_stats result;
@@ -11,6 +43,9 @@ cache_stats operator-(cache_stats lhs, cache_stats rhs)
 
   result.hits = lhs.hits - rhs.hits;
   result.misses = lhs.misses - rhs.misses;
+  result.mshr_merge = lhs.mshr_merge - rhs.mshr_merge;
+  result.mshr_return = lhs.mshr_return - rhs.mshr_return;
+  result.pc_address_misses = lhs.pc_address_misses - rhs.pc_address_misses;
 
   result.total_miss_latency_cycles = lhs.total_miss_latency_cycles - rhs.total_miss_latency_cycles;
   return result;
