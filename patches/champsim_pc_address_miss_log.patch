+struct pc_address_key {
+  std::remove_cv_t<decltype(NUM_CPUS)> cpu{};
+  uint64_t pc{};
+  uint64_t address{};
+
+  bool operator<(const pc_address_key& other) const
+  {
+    if (cpu != other.cpu) {
+      return cpu < other.cpu;
+    }
+    if (pc != other.pc) {
+      return pc < other.pc;
+    }
+    return address < other.address;
+  }
+
+  bool operator==(const pc_address_key& other) const { return cpu == other.cpu && pc == other.pc && address == other.address; }
+  bool operator!=(const pc_address_key& other) const { return !(*this == other); }
+};
