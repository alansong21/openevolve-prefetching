// Example L2C→LLC hierarchy for ChampSim L2 demand traces.
// Geometry matches workflows/combined/champsim_config.json (DPC4 1C.limitBW):
//   L2C 2048x16x64 = 2M; LLC 4096x12x64 = 3M
// ChampSim physical_memory (NOT enforced by drcachesim):
//   data_rate=800, channels=1, tCAS=6, tRCD=6, tRP=6, tRAS=13
// ChampSim cache hit latencies (NOT enforced by drcachesim):
//   L2C=10c, LLC=35c
num_cores       1
line_size       64
coherent        false
warmup_refs     0
sim_refs        0

L2C {
  type            unified
  core            0
  size            2M
  assoc           16
  prefetcher      none
  replace_policy  LRU
  parent          LLC
}

LLC {
  type            unified
  size            3M
  assoc           12
  prefetcher      none
  replace_policy  LRU
  parent          memory
}
